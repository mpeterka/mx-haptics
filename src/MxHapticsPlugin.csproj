<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Release balíček bez .pdb (obsahují lokální cesty) -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Loupedeck.MxHapticsPlugin</RootNamespace>
    <AssemblyName>MxHapticsPlugin</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <PluginApiDir Condition="'$(PluginApiDir)' == ''">C:\Program Files\Logi\LogiPluginService\</PluginApiDir>
    <!-- Kořen pluginu (metadata/, events/, win/) -->
    <PluginRootDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\build\'))</PluginRootDir>
    <OutputPath>$(PluginRootDir)win\</OutputPath>
    <PluginLinkFile>$(LOCALAPPDATA)\Logi\LogiPluginService\Plugins\MxHaptics.link</PluginLinkFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PluginApi">
      <HintPath>$(PluginApiDir)PluginApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
    <PackageFiles Include="package\**\*" />
  </ItemGroup>

  <Target Name="CopyPackage" AfterTargets="Build">
    <Copy SourceFiles="@(PackageFiles)" DestinationFolder="$(PluginRootDir)%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Okno nastavení (WinForms, net10.0-windows) do build/settings/ -->
  <Target Name="BuildSettingsApp" AfterTargets="CopyPackage" Condition="'$(SkipSettingsApp)' != 'true'">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\settings\MxHapticsSettings.csproj&quot; -c $(Configuration) -o &quot;$(PluginRootDir)settings&quot; --nologo -v q" />
  </Target>

  <!-- Vývojový .link soubor: Logi Plugin Service načte plugin přímo z build/ -->
  <Target Name="WriteLink" AfterTargets="BuildSettingsApp" Condition="'$(OS)' == 'Windows_NT' And '$(SkipPluginLink)' != 'true'">
    <WriteLinesToFile File="$(PluginLinkFile)" Lines="$(PluginRootDir)" Overwrite="true" />
    <Exec Command="start loupedeck:plugin/MxHaptics/reload" ContinueOnError="true" />
  </Target>

</Project>
